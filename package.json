{
  "name": "pageaudit",
  "version": "2.0.0",
  "description": "Multi-page SEO/HTML checker",
  "type": "module",
  "bin": {
    "pageaudit": "bin/pageaudit.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node src/api/index.ts",
    "dev": "node --watch src/api/index.ts",
    "typecheck": "tsc",
    "lint:fix": "biome check --write ."
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "cli-table3": "^0.6.5",
    "entities": "^7.0.1",
    "fastify": "^5.12.7",
    "lighthouse": "^13.5.0",
    "ora": "^9.4.1",
    "robots-parser": "^3.0.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  }
}
